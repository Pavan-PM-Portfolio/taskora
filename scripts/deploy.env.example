# Taskora — deploy settings. Copy to scripts/deploy.env (git-ignored).

# ---- Supabase ---------------------------------------------------------------
# Project Settings → General → Reference ID
TASKORA_PROJECT_REF=
# Database password you chose when creating the project (used by `db push`).
SUPABASE_DB_PASSWORD=
# Optional: a personal access token (supabase.com/dashboard/account/tokens).
# Without it the CLI uses whatever `npx supabase login` stored.
# SUPABASE_ACCESS_TOKEN=

# ---- Web hosting -------------------------------------------------------------
# github-pages  push the built site to the repo's gh-pages branch
# netlify       publish with the Netlify CLI (asks you to log in the first time)
# ec2           rsync to a server over SSH
# dir           copy into a local folder (e.g. a mounted web root)
# none          only build dist/
TASKORA_WEB_TARGET=none

# netlify target (optional: an existing site id or name)
TASKORA_NETLIFY_SITE=

# ec2 target
TASKORA_SSH_HOST=            # e.g. ec2-user@ec2-1-2-3-4.compute.amazonaws.com
TASKORA_SSH_KEY=scripts/keypair.pem
TASKORA_REMOTE_DIR=          # e.g. /var/www/taskora
# Optional command run on the server after upload (reload nginx, publish script…)
TASKORA_POST_DEPLOY_CMD=

# dir target
TASKORA_WEB_DIR=
